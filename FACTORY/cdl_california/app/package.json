{
  "name": "cdl-workshop-ca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "parse": "node --experimental-strip-types scripts/parse-lessons.ts",
    "validate": "python3 scripts/validate_content.py",
    "dev": "vite",
    "build:single": "npm run -s parse && vite build --mode single",
    "build:pwa": "npm run -s parse && vite build --mode pwa",
    "preview": "vite preview --outDir dist",
    "test": "npm run -s parse && vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "typescript": "6.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "preact": "10.29.8",
    "ts-fsrs": "5.4.2"
  }
}