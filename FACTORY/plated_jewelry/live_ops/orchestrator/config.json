  },
  "sources": [
    {
      "family": "sales_proxy",
      "signal_type": "revealed_sales_proxy",
      "reliability": "highest (revealed behavior)",
      "examples": [
        "Amazon Best Sellers (Jewelry > Earrings/Necklaces/Rings/Bracelets/Anklets)",
        "Amazon Movers & Shakers (24h rank gainers)",
        "Etsy Bestseller badge + Popular-now shelves",
        "Frequently-bought-together / customers-also-bought adjacency",
        "TikTok Shop / Instagram Shop trending + 'X sold' counters",
        "Google Shopping popular products",
        "Sold-out / restock / 'only N left' states"
      ],
      "honesty": "rank & review-count = [FACT-source]; inferred units = [ESTIMATE via named method] or [UNKNOWN]"
    },
    {
      "family": "search_interest",
      "signal_type": "search_interest",
      "reliability": "intent proxy (relative, never absolute)",
      "examples": [
        "Google Trends (relative 0-100 index; rising/breakout queries)",
        "Pinterest Trends / Pinterest Predicts",
        "Autocomplete / related queries / people-also-search",
        "Keyword-volume tools (banded)"
      ],
      "honesty": "index/band = [FACT-source]; exact volume = [ESTIMATE]; intent leads purchase, not equal to it"
    },
    {
      "family": "social_engagement",
      "signal_type": "social_engagement",
      "reliability": "earliest + most fad-inflated; never actioned alone",
      "examples": [
        "TikTok / Instagram hashtag view+post counts & growth",
        "TikTok / Instagram sounds & formats",
        "Reddit (r/jewelry, r/femalefashionadvice, r/TikTokFashion) threads/upvotes/asks",
        "Comment sentiment & recurring asks",
        "Creator / UGC velocity"
      ],
      "honesty": "views/likes/hashtags/followers = [SIGNAL] (reach), never purchase; vanity-metric caveat binding"
    },
    {
      "family": "review_velocity",
      "signal_type": "review_velocity",
      "reliability": "observable lower-bound on units",
      "examples": [
        "Review COUNT on a listing (Amazon/Etsy/marketplace/DTC)",
        "Review VELOCITY = delta-reviews / delta-days between two dated fetches"
      ],
      "honesty": "count = [FACT-source] (censored lower-bound); velocity = [ESTIMATE via two-date-delta method]; never units = reviews x invented-k"
    },
    {
      "family": "editorial_trend",
      "signal_type": "editorial_trend",
      "reliability": "lagging narrative / forecast (context only)",
      "examples": [
        "Trade press (WWD, Vogue Business, Business of Fashion, trend forecasters)",
        "Retailer / brand press releases & earnings color",
        "Season 'jewelry trends' roundups"
      ],
      "honesty": "claim-was-made = [FACT-source]; the trend call = [FACT-source, opinion/forecast]; self-reported sell-outs = [UNKNOWN]"
    }
  ],
  "poll": {
    "min_items": 6,
    "rank_by": "demand_score",
    "gate": "top buckets corroborated by >=2 live sources"
